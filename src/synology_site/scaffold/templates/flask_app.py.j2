import os
from datetime import datetime, timezone

from flask import Flask, jsonify
{% if db_enabled %}
from sqlalchemy import create_engine, text
from sqlalchemy.exc import SQLAlchemyError
{% endif %}

app = Flask(__name__)

DATA_DIR = "/app/data"
MAX_SEEN_RECORDS = 9


def _storage_info() -> str:
    os.makedirs(DATA_DIR, exist_ok=True)
    marker_path = os.path.join(DATA_DIR, "marker.txt")
    now = datetime.now(timezone.utc).isoformat()
    if not os.path.exists(marker_path):
        with open(marker_path, "w") as f:
            f.write(f"created at {now}\n")
    with open(marker_path, "a") as f:
        f.write(f"seen at {now}\n")
    with open(marker_path) as f:
        lines = f.read().splitlines()

    created_line = next((line for line in lines if line.startswith("created at")), None)
    seen_lines = [line for line in lines if line.startswith("seen at")]
    displayed_lines = ([created_line] if created_line else []) + seen_lines[-MAX_SEEN_RECORDS:]

    mount_line = "not found in /proc/mounts (no bind mount detected for this path)"
    try:
        with open("/proc/mounts") as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 2 and parts[1] == DATA_DIR:
                    mount_line = line.strip()
                    break
    except OSError as exc:
        mount_line = f"error reading /proc/mounts: {exc}"

    host_path = os.environ.get("HOST_DATA_PATH", "HOST_DATA_PATH not set")

    return (
        "<hr><h2>Storage location</h2>"
        f"<p><b>Host volume path:</b> {host_path}</p>"
        f"<p><b>Container-side path:</b> {DATA_DIR}</p>"
        f"<p><b>Mount info from /proc/mounts:</b> {mount_line}</p>"
        f"<pre><b>Marker file (created + last {MAX_SEEN_RECORDS} seen-at records):</b>\n"
        + "\n".join(displayed_lines)
        + "\n</pre>"
    )


@app.get("/")
def index():
    return (
        "<h1>It works</h1><p>{{ domain }} is running successfully.</p>"
        + _storage_info()
    )


@app.get("/health")
def health():
    return jsonify(status="ok", service="{{ slug }}", domain="{{ domain }}", framework="flask")
{% if db_enabled %}


@app.get("/db-health")
def db_health():
    database_url = os.environ.get("DATABASE_URL")
    if not database_url:
        return jsonify(
            status="error",
            database="not_connected",
            message="Database connection failed",
        ), 503
    try:
        engine = create_engine(database_url, pool_pre_ping=True)
        with engine.connect() as connection:
            connection.execute(text("SELECT 1"))
    except SQLAlchemyError:
        return jsonify(
            status="error",
            database="not_connected",
            message="Database connection failed",
        ), 503
    return jsonify(status="ok", database="connected", service="{{ slug }}")
{% endif %}
