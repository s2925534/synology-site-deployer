# VDEV-33 NAS runner stack — copy to `.env` on the NAS (gitignored) and fill in.

# --- GitHub App: "VelosoLabs CI Watchdog" ---
APP_ID=5960516
# Installation id for the target scope:
#   zqxio org      = 186673265
#   velosolabs org = 186673212
#   s2925534 user  = 186673160   (note: user-scope runners aren't supported by GitHub;
#                                  use GH_SCOPE=repo with GH_TARGET=s2925534/<repo> instead)
APP_INSTALLATION_ID=186673265
# Path ON THE NAS to the App private key (chmod 600, never in git):
APP_PRIVATE_KEY_HOST_PATH=/volume3/dockernvme/nas-ci-runner/ci-watchdog-app.pem

# --- Runner scope ---
# GH_SCOPE=org  -> one runner serves every repo in the org (GH_TARGET = org login)
# GH_SCOPE=repo -> runner serves a single repo (GH_TARGET = owner/repo)
GH_SCOPE=org
GH_TARGET=zqxio
RUNNER_GROUP=Default
RUNNER_LABELS=self-hosted,nas

# --- Heartbeat (fill AFTER the watchdog Worker is deployed) ---
WATCHDOG_URL=
HEARTBEAT_HMAC_SECRET=
HEARTBEAT_HOST_ID=nas-zqxio
